# Copy to .env (never commit .env). The server reads these from the environment.
PORT=3000
# Optional: AI commentary through Google Gemini (server-side only)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest   (default; falls back automatically)
# AI voice commentary (Gemini TTS) is on when a key is set. 0 = off.
GEMINI_TTS=1
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Requests/minute budget for AI commentary (all players combined)
GEMINI_RPM=40
# CORS / WebSocket origin allow-list when the client is hosted elsewhere
ALLOWED_ORIGINS=*
# Client build (only when the client is a separate Static Site): URL of the game server
# VITE_SERVER_URL=https://ring-kings.onrender.com
